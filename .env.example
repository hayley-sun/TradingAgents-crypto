# TradingAgents-crypto 环境变量配置
# 使用方法: source .env

# FinnHub API Key（必需 - 用于获取市场数据）
# 获取地址: https://finnhub.io/
export FINNHUB_API_KEY="FinnHub API Key"

# DeepSeek API Key（可选，也可在Web界面配置）
# 获取地址: https://platform.deepseek.com/
export DEEPSEEK_API_KEY="DeepSeek API Key"

# OpenAI API Key（可选）
# export OPENAI_API_KEY="你的_OPENAI_API_KEY"